{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "entrypoints", "*.config.ts", ".wxt/wxt.d.ts"],
  "exclude": ["node_modules"]
}
